{
    "version": 9,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables":   {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_CPP19_MODULES": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_CPP19_MODULES": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"

      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug-vulkan-tutorial",
      "inherits": "linux-debug",
      "cacheVariables": {
        "BUILD_VULKAN_TUTORIAL": "ON"
      }
    },
    {
      "name": "x64-debug-vulkan-tutorial",
      "inherits": "x64-debug",
      "cacheVariables": {
        "BUILD_VULKAN_TUTORIAL": "ON"
      }
    }
  ], 
    "buildPresets": [
      {
        "name": "vulkan-tutorial",
        "displayName": "Vulkan Tutorial",
        "configurePreset": "linux-debug-vulkan-tutorial",
        "targets": [ "VulkanTutorial" ]
      },
      {
        "name": "vulkan-tutorial-windows",
        "displayName": "Vulkan Tutorial Windows",
        "configurePreset": "x64-debug-vulkan-tutorial",
        "targets": [ "VulkanTutorial" ]
      }
    ]
}
